{
  "name": "github-mahjongg",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.10.0",
      "onFail": "download"
    }
  },
  "description": "Offline-capable Mahjongg web app",
  "license": "GPL-3.0-or-later",
  "workspaces": [],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:seeds": "bash verification/verify-seeds.sh",
    "clean": "rm -rf tmp .cpuprofile dist test-results playwright-report blob-report .playwright"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "yaml": "^2.9.1"
  }
}
